Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_mime.c>
    AddHandler application/x-httpd-ea-php83 .php
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On
# Never expose Git metadata, release sources, environment files, or uploaded scripts.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [R=404,L]
RewriteRule ^storage/.*\.(php[0-9]*|phtml|phar|cgi|pl|sh)(/|$) - [R=404,L,NC]
RewriteRule ^(?!index\.php$).*\.(php[0-9]*|phtml|phar)(/|$) - [R=404,L,NC]
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^api(?:/|$) index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^(?:collections(?:/[^/]+)?|products/[^/]+|cart|login|register|(?:portal|admin|staff)(?:/[^/]+){0,3})/?$ index.html [L]
ErrorDocument 404 /index.html
